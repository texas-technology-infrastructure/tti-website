---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
	title="Page Not Found"
	description="The page you're looking for may have moved, been removed, or never existed."
	noindex={true}
>
	<Section>
		<Container>
			<h1>Page Not Found</h1>
			<p class="not-found__lede">
				The page you're looking for may have moved, been removed, or never existed.
			</p>
			<div class="not-found__actions">
				<Button href="/">Return Home</Button>
				<Button href="/contact" variant="secondary">Contact Us</Button>
			</div>
		</Container>
	</Section>
</BaseLayout>

<style>
	.not-found__lede {
		max-width: 55ch;
		color: var(--color-text-secondary);
		margin-block: var(--space-3) var(--space-6);
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
</style>
