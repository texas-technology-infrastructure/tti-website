---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import { site } from '../data/site';
---

<BaseLayout title="Service Area" description="Where Texas Technology Infrastructure provides onsite and remote IT services.">
	<Section>
		<Container>
			<h1>Service Area</h1>
			<p>{site.serviceArea.onsite}</p>
			<p>{site.serviceArea.remote}</p>
		</Container>
	</Section>
</BaseLayout>
