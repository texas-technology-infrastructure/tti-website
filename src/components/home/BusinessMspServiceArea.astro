---
import Section from '../Section.astro';
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const mapEmbedParams = new URLSearchParams({
	key: import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_API_KEY,
	center: '32.86,-97.05',
	zoom: '9',
	maptype: 'roadmap',
});
const mapEmbedSrc = `https://www.google.com/maps/embed/v1/view?${mapEmbedParams.toString()}`;
---

<Section background="inverse">
	<Container>
		<h2>Partners for Your Success</h2>
		<p class="business-service-area__intro">
			However your team is structured, we fit in as hands-on technical support.
		</p>

		<div class="business-service-area__cards">
			<div class="business-service-area__block" id="for-businesses">
				<span class="business-service-area__icon"><Icon name="building" size={20} /></span>
				<h3>For Businesses</h3>
				<p>
					We manage and support your technology directly, whether as your outsourced IT
					department or alongside your existing team.
				</p>
				<a href="/services">Learn More <Icon name="arrow-right" size={16} /></a>
			</div>

			<div class="business-service-area__block" id="for-msps">
				<span class="business-service-area__icon"><Icon name="network-extend" size={20} /></span>
				<h3>For MSPs &amp; IT Providers</h3>
				<p>
					We act as an extension of your technical team, providing DFW field support,
					remote help desk coverage, and infrastructure work under your brand.
				</p>
				<a href="/services">Learn More <Icon name="arrow-right" size={16} /></a>
			</div>
		</div>
	</Container>
</Section>

<Section background="inverse">
	<Container>
		<h2>Proudly Serving Dallas&ndash;Fort Worth</h2>
		<p class="business-service-area__intro">
			{site.serviceArea.onsite}<br />
			{site.serviceArea.remote}
		</p>

		<div class="service-area__map">
			<iframe
				class="service-area__map-frame"
				src={mapEmbedSrc}
				title="Dallas–Fort Worth service area map"
				loading="lazy"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
			></iframe>
		</div>

		<p class="business-service-area__intro service-area__coverage">
			<strong>Serving the Dallas&ndash;Fort Worth Metroplex</strong><br />
			Dallas &bull; Fort Worth &bull; Arlington &bull; Irving / Las Colinas &bull; Plano &bull; Frisco
			&bull; Denton &bull; McKinney and surrounding North Texas communities.
		</p>
	</Container>
</Section>

<style>
	.business-service-area__intro {
		color: var(--color-text-inverse-muted);
		margin-bottom: var(--space-6);
	}

	.service-area__coverage {
		margin-top: var(--space-6);
		margin-bottom: 0;
	}

	.business-service-area__cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}

	.business-service-area__block {
		padding: var(--space-5) 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		scroll-margin-top: 6rem;
	}

	.business-service-area__block a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 600;
		font-size: var(--text-sm);
		text-decoration: none;
		margin-top: var(--space-2);
	}

	.business-service-area__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-full);
		background-color: rgba(96, 165, 250, 0.16);
		color: var(--color-blue-light);
		margin-bottom: var(--space-3);
	}

	.business-service-area__block h3 {
		margin-bottom: var(--space-2);
	}

	.business-service-area__block p {
		color: var(--color-text-inverse-muted);
		font-size: var(--text-sm);
	}

	.service-area__map {
		margin-bottom: var(--space-6);
		border-radius: var(--radius-md);
		overflow: hidden;
		height: 350px;
		background-color: var(--color-navy);
	}

	.service-area__map-frame {
		width: 100%;
		height: 100%;
		display: block;
		border: 0;
	}

	@media (min-width: 1024px) {
		.business-service-area__cards {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-8);
		}

		.service-area__map {
			height: 500px;
		}
	}
</style>
