---
import Section from '../Section.astro';
import Container from '../Container.astro';
import FeatureItem from '../FeatureItem.astro';
import Icon from '../Icon.astro';

const chips: { icon: 'globe' | 'server' | 'wrench' | 'mail' | 'signal' | 'sliders'; label: string }[] = [
	{ icon: 'globe', label: 'Website Design & Development' },
	{ icon: 'server', label: 'Website Hosting' },
	{ icon: 'wrench', label: 'Website Maintenance' },
	{ icon: 'mail', label: 'Business Email & Microsoft 365' },
	{ icon: 'signal', label: 'Domain & DNS Management' },
	{ icon: 'sliders', label: 'Ongoing Support' },
];
---

<Section>
	<Container>
		<div class="secondary-services">
			<div class="secondary-services__intro">
				<span class="secondary-services__badge"><Icon name="globe" size={20} /></span>
				<h2>Web &amp; Business Technology Services</h2>
				<p>Practical web and business technology support for teams who want one team handling it all.</p>
			</div>
			<div class="secondary-services__chips">
				{
					chips.map((chip) => (
						<FeatureItem icon={chip.icon} label={chip.label} />
					))
				}
			</div>
			<a class="secondary-services__link" href="/services">
				View All Services
				<Icon name="arrow-right" size={16} />
			</a>
		</div>
	</Container>
</Section>

<style>
	.secondary-services {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.secondary-services__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-full);
		background-color: rgba(37, 99, 235, 0.08);
		color: var(--color-blue);
		margin-bottom: var(--space-3);
	}

	.secondary-services__intro h2 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-2);
	}

	.secondary-services__intro p {
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
	}

	.secondary-services__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-6);
	}

	.secondary-services__chips > :global(.feature-item) {
		flex: 1 1 calc(50% - var(--space-3));
	}

	.secondary-services__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 600;
		font-size: var(--text-sm);
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.secondary-services__chips > :global(.feature-item) {
			flex: 1 1 calc(33.33% - var(--space-4));
		}
	}

	@media (min-width: 1024px) {
		.secondary-services {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}

		.secondary-services__intro {
			flex: 0 0 20rem;
			min-width: 0;
		}

		.secondary-services__chips {
			flex: 1 1 0%;
			min-width: 0;
		}

		.secondary-services__chips > :global(.feature-item) {
			flex: 1 1 12rem;
			min-width: 0;
		}
	}
</style>
