---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../Section.astro';
import Container from '../Container.astro';
import AudienceCard from '../AudienceCard.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
	image?: ImageMetadata;
	imageAlt?: string;
}

const {
	image,
	imageAlt = 'Technician performing structured cabling work in a server rack',
} = Astro.props;
---

<Section background="inverse">
	<Container>
		<div class="hero">
			<div class="hero__content">
				<p class="hero__eyebrow">Managed IT Services &middot; MSP Support &middot; Network Infrastructure</p>
				<h1 class="hero__heading">
					Technology support for <span class="hero__accent">businesses and IT providers</span>.
				</h1>
				<p class="hero__lede">
					We help businesses run reliable technology with hands-on managed IT support &mdash; and
					help MSPs and IT providers extend their team with dependable field service, remote
					support, and network infrastructure work across Dallas&ndash;Fort Worth.
				</p>
				<div class="hero__cards">
					<AudienceCard
						href="#for-businesses"
						icon="support"
						label="I Need IT Support"
						description="Managed IT and technology support for your business"
					/>
					<AudienceCard
						href="#for-msps"
						icon="network-extend"
						label="I'm an MSP / IT Provider"
						description="Extend your team with DFW field and remote support"
					/>
				</div>
				<p class="hero__contact">
					<Icon name="mail" size={18} />
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</p>
			</div>
			<div class="hero__media">
				{
					image ? (
						<Image
							src={image}
							alt={imageAlt}
							class="hero__image"
							loading="eager"
							fetchpriority="high"
							widths={[400, 800, 1200]}
							sizes="(min-width: 1024px) 45vw, 100vw"
						/>
					) : (
						<div class="hero__fallback" aria-hidden="true">
							<Icon name="cable" size={64} />
						</div>
					)
				}
			</div>
		</div>
	</Container>
</Section>

<style>
	.hero {
		display: grid;
		gap: var(--space-8);
	}

	.hero__eyebrow {
		font-size: var(--text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-blue-light);
		margin-bottom: var(--space-4);
	}

	.hero__heading {
		margin-bottom: var(--space-5);
	}

	.hero__accent {
		color: var(--color-blue-light);
	}

	.hero__lede {
		color: var(--color-text-inverse-muted);
		max-width: 55ch;
		margin-bottom: var(--space-6);
	}

	.hero__cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}

	.hero__contact {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-text-inverse-muted);
		font-size: var(--text-sm);
	}

	.hero__contact a {
		color: var(--color-text-inverse-muted);
	}

	.hero__contact a:hover {
		color: var(--color-white);
	}

	.hero__media {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.hero__fallback {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.25);
		background:
			repeating-linear-gradient(
				45deg,
				rgba(255, 255, 255, 0.05) 0,
				rgba(255, 255, 255, 0.05) 1px,
				transparent 1px,
				transparent 12px
			),
			linear-gradient(135deg, var(--color-navy), var(--color-blue));
	}

	@media (min-width: 640px) {
		.hero__cards {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 1024px) {
		.hero {
			grid-template-columns: 1.15fr 1fr;
			align-items: center;
		}
	}
</style>
