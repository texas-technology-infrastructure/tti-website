---
import Section from '../Section.astro';
import Container from '../Container.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---

<Section background="brand">
	<Container>
		<div class="final-cta">
			<span class="final-cta__icon"><Icon name="mail" size={24} /></span>
			<div class="final-cta__text">
				<h2>Let's Talk About Your Project</h2>
				<p>Tell us what you need and we'll follow up with next steps.</p>
			</div>
			<div class="final-cta__actions">
				<Button href={site.primaryCta.href} variant="inverse">{site.primaryCta.label}</Button>
				<Button href={`mailto:${site.email}`} variant="outline-inverse">Email Sales</Button>
			</div>
		</div>
	</Container>
</Section>

<style>
	.final-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-4);
	}

	.final-cta__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-full);
		background-color: rgba(255, 255, 255, 0.15);
	}

	.final-cta__text p {
		color: rgba(255, 255, 255, 0.85);
		margin-top: var(--space-2);
	}

	.final-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}
</style>
