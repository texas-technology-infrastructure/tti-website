---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon, { type IconName } from './Icon.astro';
import CheckList from './CheckList.astro';

interface Props {
	title: string;
	description: string;
	href: string;
	icon: IconName;
	bullets: string[];
	image?: ImageMetadata;
	imageAlt?: string;
}

const { title, description, href, icon, bullets, image, imageAlt = '' } = Astro.props;
---

<article class="service-card">
	<div class="service-card__media">
		<div class="service-card__media-inner">
			{
				image ? (
					<Image
						src={image}
						alt={imageAlt}
						class="service-card__image"
						loading="lazy"
						decoding="async"
						widths={[400, 700]}
						sizes="(min-width: 1024px) 33vw, 100vw"
					/>
				) : (
					<div class="service-card__fallback" aria-hidden="true">
						<Icon name={icon} size={48} />
					</div>
				)
			}
		</div>
		<span class="service-card__badge">
			<Icon name={icon} size={22} />
		</span>
	</div>
	<div class="service-card__body">
		<h3>{title}</h3>
		<p class="service-card__description">{description}</p>
		<CheckList items={bullets} columns={2} />
		<a class="service-card__link" href={href}>
			Learn More
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</article>

<style>
	.service-card {
		display: flex;
		flex-direction: column;
		background-color: var(--color-white);
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.service-card__media {
		position: relative;
	}

	.service-card__media-inner {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.service-card__image,
	.service-card__fallback {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.service-card__fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.35);
		background:
			repeating-linear-gradient(
				45deg,
				rgba(255, 255, 255, 0.06) 0,
				rgba(255, 255, 255, 0.06) 1px,
				transparent 1px,
				transparent 12px
			),
			linear-gradient(135deg, var(--color-navy), var(--color-blue));
	}

	.service-card__badge {
		position: absolute;
		bottom: -1.25rem;
		left: var(--space-5);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-full);
		background-color: var(--color-white);
		color: var(--color-blue);
		box-shadow: var(--shadow-md);
	}

	.service-card__body {
		padding: var(--space-8) var(--space-5) var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		flex-grow: 1;
	}

	.service-card__description {
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
	}

	.service-card__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: auto;
		padding-top: var(--space-3);
		font-weight: 600;
		font-size: var(--text-sm);
		text-decoration: none;
	}
</style>
