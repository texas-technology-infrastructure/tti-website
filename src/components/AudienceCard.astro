---
import Icon, { type IconName } from './Icon.astro';

interface Props {
	href: string;
	icon: IconName;
	label: string;
	description: string;
}

const { href, icon, label, description } = Astro.props;
---

<a class="audience-card" href={href}>
	<span class="audience-card__badge">
		<Icon name={icon} size={22} />
	</span>
	<span class="audience-card__text">
		<span class="audience-card__label">{label}</span>
		<span class="audience-card__description">{description}</span>
	</span>
	<span class="audience-card__arrow">
		<Icon name="arrow-right" size={18} />
	</span>
</a>

<style>
	.audience-card {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4);
		border-radius: var(--radius-md);
		background-color: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.14);
		text-decoration: none;
		transition: background-color var(--transition-fast), border-color var(--transition-fast);
	}

	.audience-card:hover {
		background-color: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.audience-card__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-full);
		background-color: rgba(96, 165, 250, 0.16);
		color: var(--color-blue-light);
	}

	.audience-card__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		flex-grow: 1;
	}

	.audience-card__label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: var(--text-base);
		color: var(--color-white);
	}

	.audience-card__description {
		font-size: var(--text-sm);
		color: var(--color-text-inverse-muted);
	}

	.audience-card__arrow {
		flex-shrink: 0;
		color: var(--color-blue-light);
	}
</style>
